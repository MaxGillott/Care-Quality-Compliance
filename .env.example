# Set the canonical HTTPS URL only after the actual domain is confirmed.
NEXT_PUBLIC_SITE_URL=
# Enquiries are never persisted by this application. They are sent to this mailbox.
CONTACT_EMAIL=Enquiry@cqc-compliance.co.uk
# Keep disabled until the owner explicitly authorises delivery and mailbox access is ready.
ENQUIRIES_ENABLED=false
RESEND_API_KEY=
# Use a sender on a domain verified with Resend.
ENQUIRY_FROM=
# Set the official Google Business Profile URL after it has been verified.
NEXT_PUBLIC_GOOGLE_REVIEWS_URL=
# Production rate limiting: configure a shared Redis REST service. Only short-lived
# HMAC identifiers and counters are stored, never enquiry contents or raw IPs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
# Set only when a trusted reverse proxy OVERWRITES this header with the client IP.
TRUSTED_CLIENT_IP_HEADER=
